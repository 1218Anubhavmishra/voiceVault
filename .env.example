# Copy to `.env` on the machine that runs the Node server (local dev or your live host).
# Never commit real secrets.
#
# `npm run start` / `npm run dev` load this file via Node’s `--env-file=.env` (Node 20+). Keep a `.env` in the project root.

# --- Speech-to-text provider. Recommended: elevenlabs (ElevenLabs Scribe over HTTPS).
# Optional: whisper (local faster-whisper; requires Python + model files).
# Requires ELEVENLABS_API_KEY when set to elevenlabs.
# VOICEVAULT_STT_PROVIDER=whisper
# VOICEVAULT_STT_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# Optional: scribe_v1 | scribe_v2
# ELEVENLABS_STT_MODEL=scribe_v1
# Optional: override API host (default https://api.elevenlabs.io)
# ELEVENLABS_API_URL=https://api.elevenlabs.io

# --- OpenAI title/answer generation ---
# Enables AI-generated titles after transcription, plus OpenAI quick-answer mode.
# OPENAI_API_KEY=
# Optional title model. Defaults to OPENAI_CHAT_MODEL, then gpt-5.4-nano.
# OPENAI_TITLE_MODEL=gpt-5.4-nano
# Optional shared chat model for quick answers.
# OPENAI_CHAT_MODEL=gpt-5.4-nano
# Set to 0 to keep transcript-title generation heuristic-only even when OPENAI_API_KEY is set.
# VOICEVAULT_AI_TITLES=1

# Clear integrated-terminal scrollback when the server starts (default on). Set 0 for CI or log capture.
# VOICEVAULT_CLEAR_CONSOLE=0

# Delete ephemeral scratch under data/ on each server start (__* temps in data/audio, orphan import_*_staging,
# zip uploads in data/imports older than VOICEVAULT_IMPORT_ZIP_MAX_AGE_MIN minutes). Set 0 to skip.
# VOICEVAULT_CLEAN_EPHEMERAL=0
# VOICEVAULT_IMPORT_ZIP_MAX_AGE_MIN=60

# Unsaved “new note” audio drafts on the server are deleted after this many hours (startup prune). Default 72.
# VOICEVAULT_NOTE_DRAFT_MAX_AGE_H=72

# Ingestion worker polling interval (ms). Lower = faster pickup of queued jobs (default 450; clamped 200–5000).
# VOICEVAULT_INGESTION_TICK_MS=450

# --- Python for local whisper (`server/transcribe.py`) when VOICEVAULT_STT_PROVIDER=whisper.
# Linux often has no `python` shim; default is `python3` + `.venv/bin/python3` if present.
# Set explicitly on production if needed (systemd, Docker, PaaS):
# VOICEVAULT_PYTHON=/path/to/.venv/bin/python3

# --- ffmpeg (WebM → WAV preprocessing + warmup). If `ffmpeg` is missing in the IDE PATH, set full path: ---
# VOICEVAULT_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe

# Default Whisper model when WHISPER_* unset is `small` (better accuracy than `tiny`). Override e.g.:
# WHISPER_MODEL=base

# Queued / authoritative note transcription uses WHISPER_FINAL_MODEL when set, else WHISPER_MODEL chain.
# WHISPER_FINAL_MODEL=medium

# Optional second Whisper pass on the full file. Set to a larger model than the first pass.
# WHISPER_REFINE_MODEL=medium

# Whisper device: auto (try CUDA), cuda, or cpu. Compute type defaults float16 on CUDA and int8 on CPU.
# VOICEVAULT_WHISPER_DEVICE=auto
# VOICEVAULT_WHISPER_COMPUTE_TYPE=

# Light speech high-pass before denoise/loudnorm (helps rumble). VOICEVAULT_FFMPEG_SPEECH_HP=1

# Whisper / Hindi script: auto-detect uses more audio + optional second pass for native Indic script.
# VOICEVAULT_WHISPER_LANG_DETECTION_SEGMENTS=10
# VOICEVAULT_WHISPER_LANG_DETECTION_THRESHOLD=0.45
# VOICEVAULT_WHISPER_INDIC_REFINE=1
# If Hindi is transcribed as English (Romanized), opt in: VOICEVAULT_WHISPER_TRY_HI_WHEN_EN=1
# Reduce repeated-token hallucinations when word timestamps are on: VOICEVAULT_WHISPER_HALLUCINATION_SILENCE=0.9
# Max seconds of audio used for POST /api/detect-language (STT on a short clip; default 55)
# VOICEVAULT_DETECT_LANGUAGE_MAX_SEC=55

# --- Local profiles / cookies ---
# Required for stable cookie-session secrets across server restarts (otherwise sessions reset frequently).
# VOICEVAULT_SESSION_SECRET=change-me-to-a-long-random-string

# Session cookie lifetime in milliseconds (optional). Default is ~10 years; cleared only by logging out.
# VOICEVAULT_SESSION_MAX_AGE_MS=315576000000

# --- Email settings for forgot-password OTP support ---
# One of these transport options is required for password reset email delivery.
# EMAIL_TRANSPORT_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=0
# EMAIL_SMTP_USER=user@example.com
# EMAIL_SMTP_PASS=supersecret
# EMAIL_FROM="voiceVault <no-reply@example.com>"

# Dangerous maintenance/debug APIs (`/api/debug/*`). Default off.
# VOICEVAULT_ENABLE_DEBUG_API=1

# Machine-wide controls + full DB export/import are disabled when multiple user profiles exist.
# Set this only on single-user machines / owners who understand it affects ALL profiles on this SQLite DB.
# VOICEVAULT_ALLOW_GLOBAL_CONTROLS=1
